---
import { ChevronRight, FileText } from '@lucide/astro';
import BaseLayout from './BaseLayout.astro';
import { site, legalLinks } from '../config/site';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  summary: string;
  toc: { id: string; label: string }[];
}

const { title, description, summary, toc } = Astro.props;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const jsonLd = [
  webPageSchema(siteUrl, pageUrl, title, description),
  breadcrumbSchema([
    { name: 'Home', url: siteUrl.href },
    { name: title, url: pageUrl },
  ]),
];
const current = Astro.url.pathname;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="relative overflow-hidden border-b border-zinc-200/80 bg-white">
    <div class="container-x relative py-14 sm:py-20">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-zinc-500">
          <li><a href="/" class="transition-colors hover:text-foreground">Home</a></li>
          <li aria-hidden="true"><ChevronRight class="size-3.5 text-zinc-300" /></li>
          <li>Legal</li>
          <li aria-hidden="true"><ChevronRight class="size-3.5 text-zinc-300" /></li>
          <li aria-current="page" class="text-zinc-700">{title}</li>
        </ol>
      </nav>
      <h1 class="mt-5 text-4xl font-bold tracking-tight text-foreground sm:text-5xl" style="letter-spacing: -0.03em">{title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg">{summary}</p>
      <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-medium text-zinc-600">
        <span class="size-1.5 rounded-full bg-emerald-500"></span>
        Last updated: {site.legalLastUpdated}
      </p>
    </div>
  </section>

  <div class="container-x grid gap-12 py-14 lg:grid-cols-[230px_minmax(0,1fr)] lg:gap-16 lg:py-20">
    <aside class="order-last lg:sticky lg:top-24 lg:order-none lg:self-start">
      <nav aria-label="On this page" class="hidden lg:block">
        <p class="text-xs font-semibold tracking-wider text-zinc-400 uppercase">On this page</p>
        <ol class="mt-4 border-l border-zinc-200">
          {
            toc.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  class="-ml-px block border-l border-transparent py-1.5 pl-4 text-sm text-zinc-500 transition-colors hover:border-zinc-400 hover:text-foreground"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="rounded-2xl border border-zinc-200 bg-white p-4 lg:mt-10 lg:border-0 lg:bg-transparent lg:p-0">
        <p class="px-1 text-xs font-semibold tracking-wider text-zinc-400 uppercase lg:px-0">Policies</p>
        <ul class="mt-3 space-y-0.5">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current === link.href ? 'page' : undefined}
                  class:list={[
                    'flex items-center gap-2 rounded-lg px-3 py-2 text-sm transition-colors lg:-mx-3',
                    current === link.href ? 'bg-violet-50 font-medium text-violet-700' : 'text-zinc-600 hover:bg-zinc-100/70 hover:text-foreground',
                  ]}
                >
                  <FileText class="size-4 shrink-0 opacity-70" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>

    <article class="prose-legal max-w-3xl">
      <slot />
    </article>
  </div>
</BaseLayout>
