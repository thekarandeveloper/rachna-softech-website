---
import { ArrowRight, ArrowUpRight, Check, Lightbulb, Sparkles } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import { products, productCategories, statusStyles, productCta } from '../../data/products';

const todo = [
  { title: 'Morning walk', done: true },
  { title: 'Pay electricity bill', done: true },
  { title: 'Call Maa at 8 PM', done: false },
];
const spending = [
  { label: 'Bills & recharge', amount: '₹8,900', dot: 'bg-sky-400' },
  { label: 'Food & dining', amount: '₹6,420', dot: 'bg-amber-400' },
  { label: 'Travel', amount: '₹3,180', dot: 'bg-violet-400' },
];
const habits = [
  { label: 'Meditate', days: [1, 1, 1, 1, 0, 1, 1] },
  { label: 'Read', days: [1, 0, 1, 1, 1, 1, 0] },
  { label: 'Walk', days: [1, 1, 1, 1, 1, 1, 1] },
];
const previews = ['tasks', 'money', 'health', 'notes', 'habits'];
---

<section id="products" class="border-b border-slate-200/80 bg-background py-24 sm:py-28">
  <div class="container-x">
    <SectionHeading
      eyebrow="Our products"
      title='A growing family of <span class="text-primary">everyday apps</span>'
      lead="Each app does one thing really well. Together they share one account, one design language and one private, secure platform."
    />

    <div class="mt-10 flex flex-wrap justify-center gap-2" role="group" aria-label="Filter products by category" data-reveal>
      {
        productCategories.map((category, i) => (
          <button
            type="button"
            data-filter={category}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-foreground aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white"
          >
            {category}
          </button>
        ))
      }
    </div>

    <div id="product-grid" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        products.map((product, i) => {
          const cta = productCta(product);
          const Icon = product.icon;
          return (
            <article
              class="card card-hover group flex flex-col overflow-hidden"
              data-category={product.category}
              data-reveal
              style={`--reveal-delay:${(i % 3) * 70}ms`}
            >
              <div
                aria-hidden="true"
                class:list={['relative h-48 overflow-hidden border-b border-slate-100 bg-gradient-to-b to-white', product.accent.soft]}
              >
                <div class="dot-grid absolute inset-0 opacity-70" />
                <div class="absolute inset-x-6 top-6 -bottom-2 rounded-t-xl border border-slate-200 bg-white p-3.5 shadow-sm transition-transform duration-500 group-hover:-translate-y-1">
                  {product.key === 'tasks' && (
                    <>
                      <div class="flex items-center justify-between">
                        <p class="text-[10px] font-semibold text-slate-800">Today</p>
                        <span class="text-[9px] font-semibold text-blue-700">2 of 3 done</span>
                      </div>
                      <div class="mt-2 h-1 rounded-full bg-slate-100">
                        <div class="h-full w-2/3 rounded-full bg-blue-600" />
                      </div>
                      <ul class="mt-3 space-y-2">
                        {todo.map((t) => (
                          <li class="flex items-center gap-2 rounded-lg border border-slate-100 px-2 py-1.5">
                            <span
                              class:list={[
                                'flex size-3.5 shrink-0 items-center justify-center rounded-full border-2',
                                t.done ? 'border-blue-600 bg-blue-600 text-white' : 'border-slate-300',
                              ]}
                            >
                              {t.done && <Check class="size-2" />}
                            </span>
                            <span class:list={['text-[10px] font-medium', t.done ? 'text-slate-400 line-through' : 'text-slate-700']}>{t.title}</span>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}

                  {product.key === 'money' && (
                    <>
                      <p class="text-[9px] font-medium text-slate-500">Spent this month</p>
                      <div class="flex items-end justify-between">
                        <p class="text-base font-bold text-slate-900">₹24,860</p>
                        <span class="pb-0.5 text-[9px] font-semibold text-emerald-700">71% of budget</span>
                      </div>
                      <div class="mt-1.5 h-1.5 rounded-full bg-slate-100">
                        <div class="h-full w-[71%] rounded-full bg-emerald-500" />
                      </div>
                      <div class="mt-3 space-y-1.5 text-[10px]">
                        {spending.map((s) => (
                          <div class="flex items-center gap-2">
                            <span class:list={['size-2 rounded-full', s.dot]} />
                            <span class="flex-1 text-slate-600">{s.label}</span>
                            <span class="font-medium text-slate-800">{s.amount}</span>
                          </div>
                        ))}
                      </div>
                    </>
                  )}

                  {product.key === 'health' && (
                    <>
                      <div class="flex items-center gap-4">
                        <div class="relative size-20 shrink-0">
                          <svg viewBox="0 0 64 64" class="size-full -rotate-90">
                            <circle cx="32" cy="32" r="26" fill="none" stroke-width="7" class="stroke-rose-100" />
                            <circle cx="32" cy="32" r="26" fill="none" stroke-width="7" stroke-linecap="round" stroke-dasharray="138 164" class="stroke-rose-500" />
                          </svg>
                        </div>
                        <div>
                          <p class="text-lg leading-none font-bold text-slate-900">8,432</p>
                          <p class="mt-1 text-[10px] text-slate-500">of 10,000 steps</p>
                        </div>
                      </div>
                      <div class="mt-3 grid grid-cols-2 gap-2 text-[10px]">
                        <div class="rounded-lg bg-indigo-50 px-2 py-1.5 font-semibold text-indigo-700">Sleep · 7h 20m</div>
                        <div class="rounded-lg bg-sky-50 px-2 py-1.5 font-semibold text-sky-700">Water · 6 / 8</div>
                      </div>
                    </>
                  )}

                  {product.key === 'notes' && (
                    <>
                      <p class="text-[10px] font-semibold text-slate-800">Journal · 13 Sep</p>
                      <div class="mt-2.5 space-y-1.5">
                        <div class="h-1.5 w-full rounded-full bg-slate-200" />
                        <div class="h-1.5 w-11/12 rounded-full bg-slate-200" />
                        <div class="h-1.5 w-3/4 rounded-full bg-slate-100" />
                      </div>
                      <div class="mt-3 flex items-start gap-1.5 rounded-lg border border-amber-100 bg-amber-50 px-2 py-1.5 text-[9px] leading-snug font-medium text-amber-800">
                        <Sparkles class="size-3 shrink-0" /> Summary: a calm, productive day. Remember to book the dentist.
                      </div>
                    </>
                  )}

                  {product.key === 'habits' && (
                    <>
                      <div class="flex items-center justify-between">
                        <p class="text-[10px] font-semibold text-slate-800">This week</p>
                        <span class="text-[9px] font-semibold text-violet-700">12-day streak</span>
                      </div>
                      <div class="mt-3 space-y-2">
                        {habits.map((h) => (
                          <div class="flex items-center gap-2">
                            <span class="w-12 truncate text-[9px] font-medium text-slate-600">{h.label}</span>
                            <div class="grid flex-1 grid-cols-7 gap-1">
                              {h.days.map((d) => (
                                <span class:list={['h-3.5 rounded-[3px]', d ? 'bg-violet-500' : 'bg-slate-100']} />
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </>
                  )}

                  {!previews.includes(product.key) && (
                    <div class="space-y-2.5">
                      <div class="h-2 w-20 rounded-full bg-slate-300" />
                      <div class="h-2 w-32 rounded-full bg-slate-200" />
                      <div class="h-16 rounded-lg bg-slate-50" />
                    </div>
                  )}
                </div>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-center gap-3">
                  <span class:list={['flex size-10 shrink-0 items-center justify-center rounded-xl text-white shadow-sm', product.accent.solid]}>
                    <Icon class="size-5" />
                  </span>
                  <div class="min-w-0">
                    <h3 class="truncate text-base font-semibold tracking-tight text-foreground">{product.name}</h3>
                    <p class="text-xs leading-snug text-slate-500">{product.tagline}</p>
                  </div>
                  <span class:list={['ml-auto shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-medium', statusStyles[product.status]]}>
                    {product.status}
                  </span>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-slate-600">{product.description}</p>
                <ul class="mt-4 space-y-2">
                  {product.features.map((feature) => (
                    <li class="flex items-center gap-2 text-sm text-slate-700">
                      <Check class:list={['size-4 shrink-0', product.accent.text]} />
                      {feature}
                    </li>
                  ))}
                </ul>
                <div class="mt-auto pt-6">
                  <div class="flex items-center justify-between border-t border-slate-100 pt-5">
                    <a
                      href={cta.href}
                      data-product={product.name}
                      data-topic={cta.external ? undefined : 'Product enquiry'}
                      target={cta.external ? '_blank' : undefined}
                      rel={cta.external ? 'noopener' : undefined}
                      class="group/cta inline-flex items-center gap-1.5 text-sm font-semibold text-primary"
                    >
                      {cta.label}
                      {cta.external ? (
                        <ArrowUpRight class="size-4" />
                      ) : (
                        <ArrowRight class="size-4 transition-transform group-hover/cta:translate-x-0.5" />
                      )}
                    </a>
                    <span class="text-xs font-medium text-slate-400">{product.category}</span>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }

      <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-white/60 p-8 text-center" data-reveal>
        <span class="flex size-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-600"><Lightbulb class="size-6" /></span>
        <h3 class="mt-5 text-base font-semibold text-foreground">Have an idea for an app?</h3>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-slate-500">
          Many of our products start with a conversation. Tell us what would make your day simpler.
        </p>
        <a href="#contact" data-topic="Product idea" class="btn btn-outline btn-sm mt-6">
          Share your idea
          <ArrowRight class="size-3.5" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#product-grid [data-category]');

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((card) => {
        card.hidden = filter !== 'All' && card.dataset.category !== filter;
      });
    }),
  );
</script>
