---
import { Handshake, IndianRupee, LockKeyhole, Sparkles, Users, Wallet } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import { products } from '../../data/products';

const stats = [
  { value: String(products.length), label: 'Apps in our growing family' },
  { value: '1', label: 'Account for all our apps' },
  { value: '0', label: 'Ads. We never sell your data' },
  { value: '100%', label: 'Designed, built and supported in India' },
];

const principles = [
  {
    icon: LockKeyhole,
    title: 'Privacy by design',
    description: 'Your data is yours: minimal collection, encryption everywhere, and no selling of data, ever.',
  },
  {
    icon: IndianRupee,
    title: 'Built for India',
    description: 'Rupee pricing, UPI and the way people in India actually live and work, built in from the start.',
  },
  {
    icon: Sparkles,
    title: 'AI that actually helps',
    description: 'Practical AI that saves real time, with you always in control of the final decision.',
  },
  {
    icon: Wallet,
    title: 'Fair, simple pricing',
    description: 'Clear, affordable pricing in rupees, no surprise charges and no dark patterns.',
  },
  {
    icon: Users,
    title: 'Accessible to everyone',
    description: 'Apps built to WCAG guidelines and tested on real devices and real networks.',
  },
  {
    icon: Handshake,
    title: 'Here for the long run',
    description: 'We maintain and improve every app for years, not just until launch day.',
  },
];
---

<section id="principles" class="relative isolate overflow-hidden bg-gradient-to-b from-violet-50 via-violet-50/40 to-white py-24 sm:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-32 left-1/2 h-80 w-[52rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(167,139,250,0.22),transparent)]"></div>
  </div>

  <div class="container-x">
    <SectionHeading
      eyebrow="Our principles"
      title='Principles behind <span class="text-primary">every app</span>'
      lead="Whatever we build next, these promises stay the same."
    />

    <dl class="mt-16 grid grid-cols-2 gap-4 lg:grid-cols-4" data-reveal>
      {
        stats.map((s) => (
          <div class="flex flex-col-reverse rounded-2xl bg-white p-6 shadow-[0_1px_2px_rgba(24,24,27,0.04)] ring-1 ring-violet-100 sm:p-7">
            <dt class="mt-2 text-sm leading-snug text-zinc-500">{s.label}</dt>
            <dd class="text-3xl font-bold tracking-tight text-primary sm:text-5xl">{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        principles.map(({ icon: Icon, title, description }, i) => (
          <div
            class="group rounded-2xl bg-white/80 p-6 ring-1 ring-zinc-200/70 transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-[0_18px_40px_-18px_rgba(124,58,237,0.3)] hover:ring-violet-200"
            data-reveal
            style={`--reveal-delay:${(i % 3) * 70}ms`}
          >
            <span class="flex size-11 items-center justify-center rounded-2xl bg-violet-100 text-violet-600 transition-transform duration-300 group-hover:scale-105">
              <Icon class="size-5" />
            </span>
            <h3 class="mt-4 text-base font-bold tracking-tight text-foreground">{title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-500">{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
