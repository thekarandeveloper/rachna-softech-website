---
import { Handshake, IndianRupee, LockKeyhole, Sparkles, Users, Wallet } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import { products } from '../../data/products';

const stats = [
  { value: String(products.length), label: 'Apps in our growing family' },
  { value: '1', label: 'Account for all our apps' },
  { value: '0', label: 'Ads. We never sell your data' },
  { value: '100%', label: 'Designed, built and supported in India' },
];

const principles = [
  {
    icon: LockKeyhole,
    title: 'Privacy by design',
    description: 'Your data is yours: minimal collection, encryption everywhere, and no selling of data, ever.',
  },
  {
    icon: IndianRupee,
    title: 'Built for India',
    description: 'Rupee pricing, UPI and the way people in India actually live and work, built in from the start.',
  },
  {
    icon: Sparkles,
    title: 'AI that actually helps',
    description: 'Practical AI that saves real time, with you always in control of the final decision.',
  },
  {
    icon: Wallet,
    title: 'Fair, simple pricing',
    description: 'Clear, affordable pricing in rupees, no surprise charges and no dark patterns.',
  },
  {
    icon: Users,
    title: 'Accessible to everyone',
    description: 'Apps built to WCAG guidelines and tested on real devices and real networks.',
  },
  {
    icon: Handshake,
    title: 'Here for the long run',
    description: 'We maintain and improve every app for years, not just until launch day.',
  },
];
---

<section id="principles" class="relative isolate overflow-hidden bg-ink py-24 text-white sm:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="dot-grid-dark absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,#000_20%,transparent_75%)]"></div>
    <div class="absolute top-0 left-1/2 h-80 w-[52rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-600/30 blur-3xl"></div>
  </div>

  <div class="container-x">
    <SectionHeading
      dark
      eyebrow="Our principles"
      title='Principles behind <span class="text-blue-400">every app</span>'
      lead="Whatever we build next, these promises stay the same."
    />

    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 lg:grid-cols-4" data-reveal>
      {
        stats.map((s) => (
          <div class="flex flex-col-reverse bg-ink p-6 sm:p-8">
            <dt class="mt-2 text-sm leading-snug text-slate-400">{s.label}</dt>
            <dd class="bg-gradient-to-b from-white to-slate-300 bg-clip-text text-3xl font-semibold tracking-tight text-transparent sm:text-5xl">
              {s.value}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        principles.map(({ icon: Icon, title, description }, i) => (
          <div
            class="group rounded-xl border border-white/10 bg-white/[0.03] p-6 transition-colors duration-300 hover:border-blue-400/30 hover:bg-white/[0.06]"
            data-reveal
            style={`--reveal-delay:${(i % 3) * 70}ms`}
          >
            <span class="flex size-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-blue-400 transition-colors group-hover:text-blue-300">
              <Icon class="size-5" />
            </span>
            <h3 class="mt-4 text-base font-semibold tracking-tight">{title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-400">{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
