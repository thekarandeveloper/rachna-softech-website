---
import { Picture } from 'astro:assets';
import { Check, CodeXml, PenTool, Rocket, Search } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import workshop from '../../assets/images/workshop.jpg';

const steps = [
  {
    icon: Search,
    title: 'Find a real problem',
    stage: 'Research',
    description:
      'We start with conversations, not code: talking to people to understand everyday problems that are worth solving well.',
    outcomes: ['Customer interviews', 'Problem brief', 'Success metrics'],
  },
  {
    icon: PenTool,
    title: 'Design for simplicity',
    stage: 'Design',
    description: 'Prototypes are tested with real users and refined until the product feels obvious to use, before we build it.',
    outcomes: ['Prototypes', 'Usability tests', 'Shared design system'],
  },
  {
    icon: CodeXml,
    title: 'Build on the platform',
    stage: 'Engineering',
    description:
      'Our shared foundation for accounts, sync, security and AI lets us ship reliable apps faster, with quality built in.',
    outcomes: ['Frequent releases', 'Automated tests', 'Security reviews'],
  },
  {
    icon: Rocket,
    title: 'Launch & keep improving',
    stage: 'Launch',
    description:
      'Early users shape every release. After launch we keep listening, measuring and shipping improvements.',
    outcomes: ['Beta testing', 'Feedback loops', 'Continuous updates'],
  },
];
---

<section id="process" class="border-b border-slate-200/80 bg-white py-24 sm:py-28">
  <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
      <SectionHeading
        align="left"
        eyebrow="How we build"
        title='From everyday problems to <span class="text-primary">apps people love</span>'
        lead="Every Rachna product follows the same simple path, so quality never depends on luck."
      />
      <figure class="relative mt-10 overflow-hidden rounded-2xl border border-slate-200 shadow-xl shadow-slate-900/5" data-reveal>
        <Picture
          src={workshop}
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 420px, 100vw"
          alt="A product team mapping user journeys with sticky notes during a discovery workshop"
          class="aspect-[4/3] h-auto w-full object-cover"
          pictureAttributes={{ class: 'block' }}
        />
        <figcaption class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/90 px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm backdrop-blur">
          <span class="size-1.5 rounded-full bg-primary"></span>
          Product discovery workshop
        </figcaption>
      </figure>
    </div>

    <ol class="relative space-y-4 lg:col-span-7">
      <span aria-hidden="true" class="absolute top-10 bottom-10 left-[2.9rem] hidden border-l border-dashed border-slate-300 sm:block"></span>
      {
        steps.map(({ icon: Icon, title, stage, description, outcomes }, i) => (
          <li class="card card-hover relative p-6 sm:p-7" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
              <span class="relative flex size-11 shrink-0 items-center justify-center rounded-xl border border-blue-200 bg-blue-50 text-primary">
                <Icon class="size-5" />
              </span>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="font-mono text-xs font-medium text-slate-400">0{i + 1}</span>
                  <h3 class="text-lg font-semibold tracking-tight text-foreground">{title}</h3>
                  <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-medium text-slate-600">{stage}</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
                <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
                  {outcomes.map((o) => (
                    <li class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-700">
                      <Check class="size-3.5 text-primary" />
                      {o}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
