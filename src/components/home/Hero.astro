---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import sketch from '../../assets/journey/sketch.jpg';
import thali from '../../assets/plate/thali.webp';
import sakhiHome from '../../assets/sakhi/home.webp';
import exhibition from '../../assets/journey/exhibition.jpg';
import dal from '../../assets/plate/food-dal.webp';

// "People" in the languages of India, shown one after another.
const words = [
  { text: 'people', lang: 'en' },
  { text: 'लोग', lang: 'hi' },
  { text: 'மக்கள்', lang: 'ta' },
  { text: 'মানুষ', lang: 'bn' },
  { text: 'ప్రజలు', lang: 'te' },
  { text: 'લોકો', lang: 'gu' },
];
---

<section data-theme="paper" class="hero relative overflow-hidden" aria-labelledby="hero-title">
  <div class="container-x pt-16 text-center sm:pt-24">
    <p class="inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-[13px] font-medium" style="border-color: var(--line)">
      <span class="size-1.5 rounded-full bg-sindoor"></span>
      An Indian technology company
    </p>

    <h1 id="hero-title" class="mx-auto mt-8 max-w-5xl font-display text-[3.2rem] leading-[1] font-semibold tracking-[-0.045em] sm:text-[5.6rem] lg:text-[6.8rem]">
      Technology, crafted<br />
      around{' '}
      <span class="sr-only">people.</span>
      <span aria-hidden="true" class="whitespace-nowrap">
        <span data-morph data-words={JSON.stringify(words)} lang="en" class="morph font-serif font-normal tracking-[-0.02em] text-[#C6431F] italic">people</span><span class="font-serif font-normal text-[#C6431F] italic">.</span>
      </span>
    </h1>

    <p class="text-muted mx-auto mt-7 max-w-xl text-lg leading-relaxed sm:text-[21px]">
      Rachna Labs builds calm, useful technology for everyday India. One family of apps, one design language, one account.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href="/#mission" class="btn btn-lg btn-ink">Our mission</a>
      <a href="/#apps" class="btn btn-lg border bg-white" style="border-color: var(--line)">Meet the apps <ArrowRight class="size-4" /></a>
    </div>
  </div>

  <ul
    class="hide-scrollbar mx-auto mt-16 flex max-w-[1240px] snap-x snap-mandatory items-end gap-3 overflow-x-auto px-4 pb-2 sm:mt-20 sm:gap-4 sm:px-6 lg:overflow-visible lg:px-8"
    aria-label="Moments from Rachna Labs"
  >
    <li class="tile w-[64vw] flex-none snap-center sm:w-[260px] lg:w-auto lg:flex-1">
      <div class="relative h-[300px] overflow-hidden rounded-[28px] bg-card sm:h-[320px]">
        <Image src={sketch} alt="Paper sketches of app screens" width={700} class="size-full object-cover" />
      </div>
      <p class="text-muted mt-3 text-[13px]">Sketched by hand</p>
    </li>
    <li class="tile w-[64vw] flex-none snap-center sm:w-[260px] lg:w-auto lg:flex-1">
      <div class="relative h-[300px] overflow-hidden rounded-[28px] bg-card sm:h-[380px]">
        <Image src={thali} alt="Dal, roti, sabzi and curd on a steel thali" width={700} class="size-full object-cover" />
      </div>
      <p class="text-muted mt-3 text-[13px]">Made for everyday India</p>
    </li>
    <li class="tile w-[64vw] flex-none snap-center sm:w-[260px] lg:w-auto lg:flex-[1.15]">
      <div class="sakhi-tile relative flex h-[300px] items-start justify-center overflow-hidden rounded-[28px] sm:h-[440px]">
        <Image src={sakhiHome} alt="Sakhi's home screen on an iPhone" width={600} class="mt-8 w-[68%] drop-shadow-2xl" />
      </div>
      <p class="text-muted mt-3 text-[13px]">Sakhi, live on the App Store</p>
    </li>
    <li class="tile w-[64vw] flex-none snap-center sm:w-[260px] lg:w-auto lg:flex-1">
      <div class="relative h-[300px] overflow-hidden rounded-[28px] bg-card sm:h-[380px]">
        <Image src={exhibition} alt="Visitors trying Sakhi at an exhibition" width={700} class="size-full object-cover" />
      </div>
      <p class="text-muted mt-3 text-[13px]">Built with the people it is for</p>
    </li>
    <li class="tile w-[64vw] flex-none snap-center sm:w-[260px] lg:w-auto lg:flex-1">
      <div class="relative flex h-[300px] items-center justify-center overflow-hidden rounded-[28px] bg-[#E4F4EA] sm:h-[320px]">
        <Image src={dal} alt="A bowl of dal" width={400} class="w-[78%] drop-shadow-xl" />
      </div>
      <p class="text-muted mt-3 text-[13px]">Plate, by katori and roti</p>
    </li>
  </ul>
</section>

<style>
  .sakhi-tile {
    background: linear-gradient(180deg, #fde8ef 0%, #f8c9da 100%);
  }
  .morph {
    display: inline-block;
    transition:
      opacity 0.45s ease,
      filter 0.45s ease,
      translate 0.45s ease;
  }
  .morph.is-out {
    opacity: 0;
    filter: blur(8px);
    translate: 0 0.12em;
  }
  .hide-scrollbar {
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const target = document.querySelector<HTMLElement>('[data-morph]');
  if (target && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: { text: string; lang: string }[] = JSON.parse(target.dataset.words ?? '[]');
    let index = 0;
    setInterval(() => {
      index = (index + 1) % words.length;
      target.classList.add('is-out');
      setTimeout(() => {
        target.textContent = words[index].text;
        target.lang = words[index].lang;
        target.classList.remove('is-out');
      }, 450);
    }, 2800);
  }
</script>
