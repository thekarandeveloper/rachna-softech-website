---
import { Blocks, Bot, Cloud, LifeBuoy, MonitorSmartphone, PenTool, Plug } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';

const capabilities = [
  {
    key: 'core',
    icon: Blocks,
    title: 'One account across every app',
    description:
      'Sign in once and use every Rachna app. Your account, settings and data sync securely across your phone, tablet and the web.',
    tags: ['One account', 'Cloud sync', 'Secure sign-in', 'Backups'],
    span: 'md:col-span-2',
    layout: 'md:grid md:grid-cols-2 md:items-center md:gap-8',
    art: 'md:order-2',
    text: 'md:mt-0',
  },
  {
    key: 'ai',
    icon: Bot,
    title: 'Smart, not noisy',
    description:
      'Helpful AI that suggests, summarises and reminds you at the right moment, and stays out of the way the rest of the time.',
    tags: ['Smart reminders', 'Summaries', 'Suggestions'],
  },
  {
    key: 'cloud',
    icon: Cloud,
    title: 'Private & secure by design',
    description: 'Encryption in transit and at rest, automatic backups and careful releases, so your data is safe and always there.',
    tags: ['Encryption', 'Backups', 'Privacy controls'],
  },
  {
    key: 'apps',
    icon: MonitorSmartphone,
    title: 'Phone, tablet and web',
    description: 'Every app works beautifully on Android, iOS and the web, including offline and on slower networks.',
    tags: ['Android & iOS', 'Web', 'Offline mode'],
  },
  {
    key: 'design',
    icon: PenTool,
    title: 'Calm, simple design',
    description: 'A shared design language makes every app feel familiar, accessible and easy to use from day one.',
    tags: ['Design system', 'Accessible', 'Consistent UX'],
  },
  {
    key: 'integrations',
    icon: Plug,
    title: 'Works with your life',
    description: 'Connect UPI payments, calendars, wearables and more through secure, permission-based integrations.',
    tags: ['UPI', 'Calendar sync', 'Wearables'],
  },
  {
    key: 'support',
    icon: LifeBuoy,
    title: 'Always improving',
    description:
      'Regular updates shaped by your feedback, continuous monitoring, and real people in support whenever you need help.',
    tags: ['Frequent updates', 'Monitoring', 'Human support'],
    span: 'lg:col-span-2',
    layout: 'lg:grid lg:grid-cols-2 lg:items-center lg:gap-8',
    art: 'lg:order-2',
    text: 'lg:mt-0',
  },
];

const coreProducts = [
  { label: 'Tasks', dot: 'fill-blue-600' },
  { label: 'Money', dot: 'fill-emerald-500' },
  { label: 'Health', dot: 'fill-rose-500' },
];
---

<section id="platform" class="border-b border-slate-200/80 bg-white py-24 sm:py-28">
  <div class="container-x">
    <SectionHeading
      eyebrow="The platform"
      title='One foundation <span class="text-primary">under every product</span>'
      lead="A shared account, privacy, sync and design mean every new app we launch feels familiar, secure and connected from day one."
    />

    <div class="mt-16 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        capabilities.map(({ key, icon: Icon, title, description, tags, span, layout, art, text }, i) => (
          <article class:list={['card card-hover group p-6', span, layout]} data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <div
              class:list={[
                'rounded-lg border border-slate-100 bg-background p-2 transition-colors duration-300 group-hover:border-blue-100',
                art,
              ]}
            >
              {key === 'core' && (
                <svg viewBox="0 0 364 150" class="h-auto w-full" fill="none" aria-hidden="true">
                  <g class="stroke-blue-300" stroke-width="1.5" stroke-dasharray="4 4">
                    <path class="animate-dash" d="M96 31C114 31 114 75 132 75" />
                    <path class="animate-dash" d="M96 75H132" />
                    <path class="animate-dash" d="M96 119C114 119 114 75 132 75" />
                    <path class="animate-dash" d="M224 75C242 75 242 31 260 31" />
                    <path class="animate-dash" d="M224 75H260" />
                    <path class="animate-dash" d="M224 75C242 75 242 119 260 119" />
                  </g>
                  {coreProducts.map((p, n) => (
                    <g transform={`translate(8 ${18 + n * 44})`}>
                      <rect width="88" height="26" rx="7" class="fill-white stroke-slate-200" stroke-width="1.2" />
                      <circle cx="13" cy="13" r="4" class={p.dot} />
                      <text x="24" y="16.5" font-size="10" font-weight="600" class="fill-slate-600">
                        {p.label}
                      </text>
                    </g>
                  ))}
                  <g transform="translate(132 43)">
                    <rect width="92" height="64" rx="12" class="fill-blue-600" />
                    <text x="46" y="30" text-anchor="middle" font-size="11" font-weight="700" class="fill-white">Rachna Core</text>
                    <text x="46" y="46" text-anchor="middle" font-size="8.5" class="fill-blue-100">Account · Sync · Security</text>
                  </g>
                  {['Single sign-on', 'Cloud sync', 'Backups'].map((t, n) => (
                    <g transform={`translate(260 ${18 + n * 44})`}>
                      <rect width="96" height="26" rx="7" class="fill-white stroke-slate-200" stroke-width="1.2" />
                      <rect x="9" y="8" width="10" height="10" rx="3" class="fill-blue-50 stroke-blue-300" />
                      <text x="25" y="16.5" font-size="9.5" font-weight="600" class="fill-slate-600">
                        {t}
                      </text>
                    </g>
                  ))}
                </svg>
              )}

              {key === 'ai' && (
                <svg viewBox="0 0 240 100" class="h-24 w-full" fill="none" aria-hidden="true">
                  <rect x="20" y="20" width="200" height="60" rx="8" class="fill-white stroke-slate-200" stroke-width="1.5" />
                  <rect x="34" y="34" width="92" height="8" rx="4" class="fill-slate-200" />
                  <rect x="34" y="50" width="64" height="8" rx="4" class="fill-slate-100" />
                  <rect x="102" y="50" width="3" height="8" rx="1.5" class="animate-pulse-soft fill-blue-600" />
                  <path d="M146 38l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" class="fill-blue-600" />
                  <rect x="166" y="32" width="42" height="36" rx="6" class="fill-blue-50 stroke-blue-200" />
                  <path d="M174 42h26M174 50h18M174 58h24" class="stroke-blue-400" stroke-width="2" stroke-linecap="round" />
                </svg>
              )}

              {key === 'cloud' && (
                <svg viewBox="0 0 240 100" class="h-24 w-full" fill="none" aria-hidden="true">
                  <rect x="20" y="20" width="200" height="60" rx="8" class="fill-white stroke-slate-200" stroke-width="1.5" />
                  <path d="M48 44H192" class="stroke-slate-200" stroke-width="2" />
                  <path d="M48 44H144" class="stroke-blue-500" stroke-width="2" />
                  {[48, 96, 144].map((x) => (
                    <g>
                      <circle cx={x} cy="44" r="8" class="fill-blue-600" />
                      <path d={`M${x - 3.5} 44l2.5 2.5 4.5-5`} class="stroke-white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </g>
                  ))}
                  <circle cx="192" cy="44" r="8" class="fill-white stroke-blue-500" stroke-width="2" />
                  <circle cx="192" cy="44" r="3" class="animate-pulse-soft fill-blue-500" />
                  {['Build', 'Test', 'Scan', 'Release'].map((label, n) => (
                    <text x={48 + n * 48} y="68" text-anchor="middle" font-size="9" font-weight="500" class="fill-slate-500">
                      {label}
                    </text>
                  ))}
                </svg>
              )}

              {key === 'apps' && (
                <svg viewBox="0 0 240 100" class="h-24 w-full" fill="none" aria-hidden="true">
                  <rect x="22" y="18" width="136" height="66" rx="7" class="fill-white stroke-slate-200" stroke-width="1.5" />
                  <path d="M22 30h136" class="stroke-slate-200" stroke-width="1.2" />
                  <circle cx="31" cy="24" r="2" class="fill-slate-300" />
                  <circle cx="38" cy="24" r="2" class="fill-slate-300" />
                  <circle cx="45" cy="24" r="2" class="fill-slate-300" />
                  <rect x="32" y="38" width="54" height="8" rx="4" class="fill-slate-200" />
                  <rect x="32" y="52" width="80" height="6" rx="3" class="fill-slate-100" />
                  <rect x="32" y="64" width="36" height="12" rx="4" class="fill-blue-600" />
                  <rect x="164" y="12" width="52" height="78" rx="10" class="fill-white stroke-slate-300" stroke-width="1.5" />
                  <rect x="182" y="17" width="16" height="3" rx="1.5" class="fill-slate-200" />
                  <rect x="172" y="28" width="36" height="22" rx="5" class="fill-blue-50 stroke-blue-200" />
                  <rect x="172" y="56" width="28" height="5" rx="2.5" class="fill-slate-200" />
                  <rect x="172" y="66" width="36" height="12" rx="4" class="fill-blue-600" />
                </svg>
              )}

              {key === 'design' && (
                <svg viewBox="0 0 240 100" class="h-24 w-full" fill="none" aria-hidden="true">
                  <rect x="20" y="20" width="200" height="60" rx="8" class="fill-white stroke-slate-200" stroke-width="1.5" />
                  <circle cx="40" cy="36" r="5" class="fill-blue-600" />
                  <circle cx="40" cy="50" r="5" class="fill-slate-800" />
                  <circle cx="40" cy="64" r="5" class="fill-blue-200" />
                  <path d="M56 28v44" class="stroke-slate-100" stroke-width="1.5" />
                  <rect x="84" y="38" width="96" height="24" rx="6" class="fill-blue-600" />
                  <rect x="104" y="47" width="56" height="6" rx="3" class="fill-white/80" />
                  <rect x="78" y="32" width="108" height="36" rx="3" class="stroke-blue-500" stroke-width="1" stroke-dasharray="3 3" />
                  {[
                    [78, 32],
                    [186, 32],
                    [78, 68],
                    [186, 68],
                  ].map(([x, y]) => (
                    <rect x={x - 3} y={y - 3} width="6" height="6" rx="1" class="fill-white stroke-blue-500" stroke-width="1.2" />
                  ))}
                  <path d="M178 58l14 5-6 2-2 6z" class="fill-slate-900 stroke-white" stroke-width="1" stroke-linejoin="round" />
                </svg>
              )}

              {key === 'integrations' && (
                <svg viewBox="0 0 240 100" class="h-24 w-full" fill="none" aria-hidden="true">
                  <rect x="20" y="20" width="200" height="60" rx="8" class="fill-white stroke-slate-200" stroke-width="1.5" />
                  <g class="stroke-blue-300" stroke-width="1.5" stroke-dasharray="3 3">
                    <path class="animate-dash" d="M74 36C92 36 90 50 106 50" />
                    <path class="animate-dash" d="M74 64C92 64 90 50 106 50" />
                    <path class="animate-dash" d="M166 36C148 36 150 50 134 50" />
                    <path class="animate-dash" d="M166 64C148 64 150 50 134 50" />
                  </g>
                  {[
                    { label: 'UPI', x: 34, y: 27 },
                    { label: 'Watch', x: 34, y: 55 },
                    { label: 'Mail', x: 166, y: 27 },
                    { label: 'Apps', x: 166, y: 55 },
                  ].map((node) => (
                    <g transform={`translate(${node.x} ${node.y})`}>
                      <rect width="40" height="18" rx="5" class="fill-slate-50 stroke-slate-200" stroke-width="1.2" />
                      <text x="20" y="12.5" text-anchor="middle" font-size="8.5" font-weight="600" class="fill-slate-600">
                        {node.label}
                      </text>
                    </g>
                  ))}
                  <circle cx="120" cy="50" r="14" class="fill-blue-600" />
                  <text x="120" y="53.5" text-anchor="middle" font-size="8.5" font-weight="700" class="fill-white">API</text>
                </svg>
              )}

              {key === 'support' && (
                <svg viewBox="0 0 360 150" class="h-auto w-full" fill="none" aria-hidden="true">
                  <rect x="0.75" y="0.75" width="358.5" height="148.5" rx="10" class="fill-white stroke-slate-200" stroke-width="1.5" />
                  <circle cx="22" cy="25" r="4" class="fill-emerald-500" />
                  <text x="32" y="28.5" font-size="10.5" font-weight="600" class="fill-slate-700">Service health</text>
                  <text x="338" y="28.5" text-anchor="end" font-size="9.5" font-weight="600" class="fill-emerald-600">Operational</text>
                  {Array.from({ length: 45 }, (_, n) => (
                    <rect x={16 + n * 7.3} y="44" width="5" height="44" rx="2" class={n === 31 ? 'fill-amber-400' : 'fill-emerald-400'} />
                  ))}
                  <text x="16" y="104" font-size="9" class="fill-slate-400">90 days ago</text>
                  <text x="344" y="104" text-anchor="end" font-size="9" class="fill-slate-400">Today</text>
                  <line x1="16" y1="116" x2="344" y2="116" class="stroke-slate-100" />
                  {['Monitoring', 'Alerting', 'Patching', 'Backups'].map((label, n) => (
                    <g transform={`translate(${16 + n * 84} 124)`}>
                      <rect width="76" height="16" rx="8" class="fill-blue-50" />
                      <text x="38" y="11" text-anchor="middle" font-size="8.5" font-weight="600" class="fill-blue-700">
                        {label}
                      </text>
                    </g>
                  ))}
                </svg>
              )}
            </div>

            <div class:list={['mt-5', text]}>
              <div class="flex items-center gap-2.5">
                <span class="flex size-8 items-center justify-center rounded-lg bg-blue-50 text-primary">
                  <Icon class="size-4" />
                </span>
                <h3 class="text-base font-semibold tracking-tight text-foreground transition-colors group-hover:text-primary">{title}</h3>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-slate-500">{description}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <li class="rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-medium text-slate-600">{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
