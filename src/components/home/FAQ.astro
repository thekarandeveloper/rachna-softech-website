---
import { Plus } from '@lucide/astro';
import { faqs } from '../../data/faqs';
import { site } from '../../config/site';
---

<section id="faq" data-theme="paper" class="scroll-mt-12 py-28 sm:py-40">
  <div class="container-x mx-auto max-w-3xl">
    <div class="text-center" data-reveal>
      <h2 class="section-title">Questions? Answers.</h2>
      <p class="text-muted mt-5 text-lg">
        Still curious? Write to us at{' '}
        <a href={`mailto:${site.email}`} class="underline underline-offset-4">{site.email}</a>.
      </p>
    </div>

    <div class="mt-14 border-b" style="border-color: var(--line)" data-reveal>
      {
        faqs.map((faq) => (
          <details class="group border-t" style="border-color: var(--line)" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left font-display text-xl font-semibold tracking-[-0.02em] [&::-webkit-details-marker]:hidden">
              {faq.q}
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-white text-[#1d1d1f] transition-transform duration-300 group-open:rotate-45">
                <Plus class="size-4" />
              </span>
            </summary>
            <p class="text-muted pr-12 pb-6 text-[17px] leading-relaxed">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
