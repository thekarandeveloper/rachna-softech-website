---
import { Image } from 'astro:assets';
import thali from '../../assets/plate/thali.webp';
import sakhiHome from '../../assets/sakhi/home.webp';
import notebook from '../../assets/journey/notebook.jpg';
import exhibition from '../../assets/journey/exhibition.jpg';

type Token = string | { image: ImageMetadata; alt: string; position?: string };

// The mission, word by word, with small photos set into the sentence.
const tokens: Token[] = [
  ...'Rachna means creation. We create calm, useful technology for'.split(' '),
  { image: thali, alt: 'A home-cooked Indian meal' },
  ...'every kitchen,'.split(' '),
  { image: sakhiHome, alt: 'Sakhi on an iPhone', position: '50% 18%' },
  ...'every woman,'.split(' '),
  { image: notebook, alt: 'Handwritten notes in a notebook' },
  ...'every student and'.split(' '),
  { image: exhibition, alt: 'People trying our app at an exhibition' },
  ...'every small team with a big idea.'.split(' '),
];

const pillars = [
  {
    title: 'Built for people, not for screens.',
    body: 'Every app starts with a real person and a real day: someone planning meals, studying before an exam, or walking home late.',
  },
  {
    title: 'One ecosystem, not scattered apps.',
    body: 'One Rachna account and one design language, so every new app feels familiar from the very first tap.',
  },
  {
    title: 'Made in India, with care.',
    body: 'Native on every phone, private by default, and every number or health claim backed by a named source.',
  },
];
---

<section id="mission" data-theme="paper" class="scroll-mt-12">
  <div class="container-x py-28 sm:py-40">
    <p class="text-muted text-center text-[15px] font-medium sm:text-[17px]">Our mission</p>
    <p data-statement class="mx-auto mt-6 max-w-5xl text-center font-display text-[2rem] leading-[1.25] font-semibold tracking-[-0.03em] sm:text-[3.3rem]">
      {
        tokens.map((t) =>
          typeof t === 'string' ? (
            <span class="statement-word">{t} </span>
          ) : (
            <span class="statement-word inline-block align-middle">
              <Image
                src={t.image}
                alt={t.alt}
                width={240}
                class="mx-1 inline-block h-[0.95em] w-[1.9em] -translate-y-[0.06em] rounded-full object-cover"
                style={t.position ? `object-position: ${t.position}` : undefined}
              />{' '}
            </span>
          ),
        )
      }
    </p>
  </div>

  <div class="container-x pb-28 sm:pb-40">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <figure class="relative" data-reveal>
        <Image src={exhibition} alt="Visitors trying Sakhi at an exhibition stall" width={1200} class="aspect-[4/5] w-full rounded-[36px] object-cover sm:aspect-[5/4]" />
        <figcaption class="glass absolute bottom-4 left-4 rounded-full px-4 py-2 text-[13px] font-medium">Showing Sakhi to the people it is for</figcaption>
      </figure>

      <div>
        <h2 class="font-display text-[2.6rem] leading-[1.05] font-semibold tracking-[-0.04em] sm:text-[3.6rem]" data-reveal>
          Technology should feel like it was <span class="text-gradient">made for you.</span>
        </h2>
        <ol class="mt-12 space-y-9">
          {
            pillars.map((p, i) => (
              <li class="grid grid-cols-[3rem_1fr] gap-4" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
                <span class="font-display text-[2rem] leading-none font-semibold tracking-tight text-gradient">0{i + 1}</span>
                <span>
                  <span class="block font-display text-[1.45rem] leading-tight font-semibold tracking-[-0.02em]">{p.title}</span>
                  <span class="text-muted mt-2 block text-[17px] leading-relaxed">{p.body}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .statement-word {
    transition: opacity 0.3s linear;
  }
  :global(.js) .statement-word {
    opacity: 0.18;
  }
  :global(.js) .statement-word.is-lit {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .statement-word {
      opacity: 1;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-statement]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...root.querySelectorAll<HTMLElement>('.statement-word')];
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight;
      const progress = Math.min(1, Math.max(0, (vh * 0.8 - rect.top) / (rect.height + vh * 0.3)));
      const lit = Math.round(progress * words.length);
      words.forEach((w, i) => w.classList.toggle('is-lit', i < lit));
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
