---
import { Image } from 'astro:assets';
import notebook from '../../assets/journey/notebook.jpg';
import sketch from '../../assets/journey/sketch.jpg';
import figma from '../../assets/journey/figma.jpg';
import kanban from '../../assets/journey/kanban.jpg';
import exhibition from '../../assets/journey/exhibition.jpg';
import sakhiHome from '../../assets/sakhi/home.webp';

const steps = [
  { image: notebook, step: 'Idea', title: 'It starts in a notebook.', body: 'Every app begins as a real problem, written down by hand.' },
  { image: sketch, step: 'Sketch', title: 'Then on paper.', body: 'Screens drawn and redrawn before a single pixel.' },
  { image: figma, step: 'Design', title: 'Then in design.', body: 'The icon and every screen refined until they feel right.' },
  { image: kanban, step: 'Build', title: 'Then we build.', body: 'One card at a time, moved across the board.' },
  { image: exhibition, step: 'Listen', title: 'Then we listen.', body: 'In front of real people, before and after launch.' },
  { image: sakhiHome, step: 'Ship', title: 'And it ships.', body: 'Sakhi has been live on the App Store since June 2025.', phone: true },
];

const milestones = [
  { date: 'Jun 2025', title: 'Sakhi launches on the App Store' },
  { date: 'Sep 2026', title: 'Rachna Labs goes online' },
  { date: 'Oct 2026', title: 'Rachna Kit and native apps on Kotlin' },
  { date: 'Oct 2026', title: 'Plate’s food catalog and API' },
  { date: 'Next', title: 'One Rachna account', next: true },
];
---

<section id="journey" data-theme="paper" class="scroll-mt-12 overflow-hidden py-28 sm:py-40">
  <div class="container-x">
    <div class="max-w-3xl" data-reveal>
      <p class="text-muted text-[15px] font-medium sm:text-[17px]">Our journey</p>
      <h2 class="mt-3 font-display text-[2.6rem] leading-[1.05] font-semibold tracking-[-0.04em] sm:text-[4rem]">From a notebook to the App Store.</h2>
      <p class="text-muted mt-5 max-w-xl text-lg leading-relaxed sm:text-[21px]">How we made Sakhi, our first app, and how we make every app since.</p>
    </div>
  </div>

  <ol
    class="hide-scrollbar mt-14 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:mt-20 sm:gap-5 sm:px-6 lg:scroll-px-[max(2rem,calc((100vw_-_1240px)/2_+_2rem))] lg:px-[max(2rem,calc((100vw_-_1240px)/2_+_2rem))]"
  >
    {
      steps.map((s, i) => (
        <li class="w-[78vw] flex-none snap-start sm:w-[380px]" data-reveal style={`--reveal-delay: ${Math.min(i, 3) * 80}ms`}>
          <div class:list={['relative aspect-[4/5] overflow-hidden rounded-[32px]', s.phone ? 'journey-ship flex items-end justify-center' : 'bg-card']}>
            {s.phone ? (
              <Image src={s.image} alt="Sakhi's home screen" width={600} class="w-[62%] translate-y-[8%] drop-shadow-2xl" />
            ) : (
              <Image src={s.image} alt="" width={900} class="size-full object-cover" />
            )}
            <span class="glass absolute top-4 left-4 rounded-full px-3 py-1 text-xs font-semibold">
              {String(i + 1).padStart(2, '0')} · {s.step}
            </span>
          </div>
          <h3 class="mt-5 font-display text-2xl font-semibold tracking-[-0.03em]">{s.title}</h3>
          <p class="text-muted mt-1.5 text-[17px] leading-snug">{s.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="container-x mt-20 sm:mt-28">
    <ol class="grid gap-6 border-t pt-8 sm:grid-cols-5" style="border-color: var(--line)">
      {
        milestones.map((m) => (
          <li>
            <p class:list={['text-[13px] font-medium', m.next ? 'text-sindoor' : 'text-muted']}>{m.date}</p>
            <p class:list={['mt-1 text-[17px] leading-snug font-semibold tracking-[-0.01em]', m.next && 'text-gradient']}>{m.title}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .journey-ship {
    background: linear-gradient(160deg, #fbe0ea, #f6b9cf 55%, #e86b98);
  }
  .hide-scrollbar {
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
