---
import { Picture } from 'astro:assets';
import { BadgeCheck, Calendar, HeartHandshake, LockKeyhole, Rocket } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';
import coworkers from '../../assets/images/coworkers-india.jpg';

const practices = [
  {
    icon: HeartHandshake,
    title: 'Customer-obsessed',
    description: 'Every feature starts with a real customer problem, not a hunch.',
  },
  {
    icon: Rocket,
    title: 'Ship small, ship often',
    description: 'Frequent releases mean faster feedback and fewer surprises.',
  },
  {
    icon: BadgeCheck,
    title: 'Quality by default',
    description: 'Code review, automated tests and design review on every change.',
  },
  {
    icon: LockKeyhole,
    title: 'Privacy first',
    description: 'We collect only what a product needs, and we never sell data.',
  },
];
---

<section id="culture" class="border-b border-zinc-200/80 bg-background py-24 sm:py-28">
  <div class="container-x grid items-center gap-16 lg:grid-cols-2">
    <div class="relative" data-reveal>
      <div class="overflow-hidden rounded-2xl border border-zinc-200 shadow-2xl shadow-zinc-900/10">
        <Picture
          src={coworkers}
          formats={['avif', 'webp']}
          widths={[560, 840, 1120]}
          sizes="(min-width: 1024px) 560px, 100vw"
          alt="Two colleagues collaborating on a product at a laptop in a bright office"
          class="aspect-[5/4] h-auto w-full object-cover"
          pictureAttributes={{ class: 'block' }}
        />
      </div>

      <div
        aria-hidden="true"
        class="animate-float absolute -top-5 -right-3 hidden w-60 rounded-xl border border-zinc-200 bg-white/95 p-4 shadow-xl shadow-zinc-900/10 backdrop-blur sm:block lg:-right-8"
      >
        <div class="flex items-center gap-2 text-xs font-semibold text-foreground">
          <span class="flex size-7 items-center justify-center rounded-lg bg-violet-50 text-primary"><Calendar class="size-3.5" /></span>
          Weekly product review
        </div>
        <p class="mt-2 text-[11px] text-zinc-500">Every Friday · 4:00 PM IST</p>
        <div class="mt-3 flex -space-x-2">
          {
            ['PM', 'UX', 'Eng', 'QA'].map((who, i) => (
              <span
                class:list={[
                  'flex size-7 items-center justify-center rounded-full text-[9px] font-semibold text-white ring-2 ring-white',
                  ['bg-zinc-800', 'bg-violet-600', 'bg-indigo-500', 'bg-sky-500'][i],
                ]}
              >
                {who}
              </span>
            ))
          }
        </div>
      </div>

      <div
        aria-hidden="true"
        class="animate-float absolute -bottom-6 -left-3 hidden w-64 rounded-xl border border-zinc-200 bg-white/95 p-4 shadow-xl shadow-zinc-900/10 backdrop-blur sm:block xl:-left-8"
        style="animation-delay: -3s"
      >
        <div class="flex items-center justify-between text-xs">
          <span class="font-semibold text-foreground">Rachna Tasks · Sprint 14</span>
          <span class="font-medium text-emerald-600">On track</span>
        </div>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-zinc-100">
          <div class="h-full w-[86%] rounded-full bg-gradient-to-r from-violet-500 to-primary"></div>
        </div>
        <p class="mt-2 text-[11px] text-zinc-500">18 of 21 tasks done · demo on Friday</p>
      </div>
    </div>

    <div>
      <SectionHeading
        align="left"
        eyebrow="Our culture"
        title='Small team. High standards. <span class="text-primary">Real craft.</span>'
        lead="We are product thinkers, designers and engineers who care about the details. We ship often, listen closely to the people who use our products, and hold every product to the same high bar."
      />
      <dl class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          practices.map(({ icon: Icon, title, description }, i) => (
            <div class="flex gap-3.5" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-zinc-200 bg-white text-primary shadow-sm">
                <Icon class="size-[18px]" />
              </span>
              <div>
                <dt class="text-sm font-semibold text-foreground">{title}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-zinc-500">{description}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
