---
import { ArrowRight, Clock, Mail, MapPin, Phone, Sparkles } from '@lucide/astro';
import { site, hasAddress, fullAddress } from '../../config/site';
import { products } from '../../data/products';

const nextSteps = [
  'We read every message ourselves',
  'The right person from our team replies within one business day',
  'We set up a quick call and agree on clear next steps',
];

const topics = ['Business enquiry', 'Partnership', 'Product enquiry', 'Product idea', 'Careers', 'Press & media', 'Something else'];
const productOptions = ['General / not sure', ...products.map((p) => p.name)];
const endpoint = site.contactFormEndpoint;
---

<section id="contact" class="bg-white py-24 sm:py-28">
  <div class="container-x">
    <div
      class="grid overflow-hidden rounded-[2rem] border border-zinc-200/70 bg-white shadow-[0_30px_80px_-40px_rgba(124,58,237,0.35)] lg:grid-cols-5"
      data-reveal
    >
      <div class="relative isolate overflow-hidden bg-gradient-to-br from-violet-100 via-violet-50 to-fuchsia-50 p-8 sm:p-10 lg:col-span-2">
        <div aria-hidden="true" class="pointer-events-none absolute -top-20 -right-20 -z-10 size-64 rounded-full bg-violet-200/60 blur-2xl"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-16 -z-10 size-72 rounded-full bg-fuchsia-200/40 blur-2xl"></div>

        <span class="eyebrow bg-white/80">
          <Sparkles class="size-3.5" /> Contact
        </span>
        <h2 class="mt-5 text-3xl font-bold tracking-tight text-foreground sm:text-4xl" style="letter-spacing: -0.03em">Let's work together</h2>
        <p class="mt-4 leading-relaxed text-zinc-600">
          Have a project, partnership or business idea in mind, or a question about our apps? Send us a message and the right person from our
          team will get back to you.
        </p>

        <ul class="mt-8 space-y-3.5 text-sm">
          <li>
            <a href={`mailto:${site.email}`} class="inline-flex items-center gap-3 font-medium text-zinc-700 transition-colors hover:text-primary">
              <span class="flex size-10 items-center justify-center rounded-2xl bg-white text-primary shadow-sm"><Mail class="size-4" /></span>
              {site.email}
            </a>
          </li>
          {
            site.phone && (
              <li>
                <a
                  href={`tel:${site.phone.replace(/\s/g, '')}`}
                  class="inline-flex items-center gap-3 font-medium text-zinc-700 transition-colors hover:text-primary"
                >
                  <span class="flex size-10 items-center justify-center rounded-2xl bg-white text-primary shadow-sm"><Phone class="size-4" /></span>
                  {site.phone}
                </a>
              </li>
            )
          }
          {
            hasAddress && (
              <li class="flex items-start gap-3 font-medium text-zinc-700">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-2xl bg-white text-primary shadow-sm"><MapPin class="size-4" /></span>
                <span class="pt-2.5">{fullAddress}</span>
              </li>
            )
          }
          <li class="inline-flex items-center gap-3 font-medium text-zinc-700">
            <span class="flex size-10 items-center justify-center rounded-2xl bg-white text-primary shadow-sm"><Clock class="size-4" /></span>
            Mon–Fri · 10:00 AM – 7:00 PM IST
          </li>
        </ul>

        <div class="mt-10 border-t border-violet-200/70 pt-8">
          <p class="text-xs font-semibold tracking-[0.14em] text-violet-700/80 uppercase">What happens next</p>
          <ol class="mt-4 space-y-3">
            {
              nextSteps.map((step, i) => (
                <li class="flex gap-3 text-sm text-zinc-600">
                  <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-[11px] font-semibold text-white">{i + 1}</span>
                  <span class="pt-0.5">{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <div class="p-8 sm:p-10 lg:col-span-3">
        <h3 class="text-xl font-bold tracking-tight text-foreground">Send us a message</h3>
        <p class="mt-1.5 text-sm text-zinc-500">Fields marked * are required. Your details stay confidential.</p>

        <form
          id="contact-form"
          class="mt-8 grid gap-5 sm:grid-cols-2"
          action={endpoint || `mailto:${site.email}`}
          method="post"
          enctype={endpoint ? undefined : 'text/plain'}
          data-endpoint={endpoint}
          data-email={site.email}
        >
          <div>
            <label for="cf-name" class="label">Full name <span class="text-primary">*</span></label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" class="input" placeholder="Aarav Sharma" />
          </div>
          <div>
            <label for="cf-email" class="label">Email <span class="text-primary">*</span></label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="160" class="input" placeholder="aarav@company.com" />
          </div>
          <div>
            <label for="cf-company" class="label">Company</label>
            <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="120" class="input" placeholder="Company name" />
          </div>
          <div>
            <label for="cf-phone" class="label">Phone</label>
            <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="20" class="input" placeholder="+91 98765 43210" />
          </div>
          <div>
            <label for="cf-topic" class="label">Topic</label>
            <select id="cf-topic" name="topic" class="input">
              {topics.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div>
            <label for="cf-product" class="label">Product</label>
            <select id="cf-product" name="product" class="input">
              {productOptions.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="cf-message" class="label">Message <span class="text-primary">*</span></label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              required
              minlength="10"
              maxlength="4000"
              class="input"
              placeholder="Tell us what you're looking for…"></textarea>
          </div>

          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

          <label class="flex items-start gap-3 text-sm text-zinc-600 sm:col-span-2">
            <input type="checkbox" name="consent" required class="mt-0.5 size-4 shrink-0 rounded border-zinc-300 accent-primary" />
            <span>
              I agree to the <a href="/privacy-policy/" class="font-semibold text-primary underline decoration-violet-200 underline-offset-4 hover:decoration-primary">Privacy Policy</a>{' '}
              and consent to being contacted about my message.
            </span>
          </label>

          <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
            <button type="submit" class="btn btn-primary btn-lg w-full disabled:cursor-wait disabled:opacity-70 sm:w-auto">
              Send message
              <ArrowRight class="size-4" />
            </button>
            <p class="text-xs text-zinc-500">We never share your details with third parties.</p>
          </div>

          <p id="form-status" role="status" aria-live="polite" hidden class="rounded-xl border px-4 py-3 text-sm sm:col-span-2"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const status = form.querySelector<HTMLElement>('#form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const topicSelect = form.querySelector<HTMLSelectElement>('#cf-topic')!;
    const productSelect = form.querySelector<HTMLSelectElement>('#cf-product')!;
    const endpoint = form.dataset.endpoint;
    const email = form.dataset.email ?? '';

    // Links elsewhere on the page (product cards, "Partner with us", etc.) pre-fill the form.
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-topic], [data-product]');
      if (!trigger) return;
      const { topic, product } = trigger.dataset;
      if (topic && [...topicSelect.options].some((o) => o.value === topic)) topicSelect.value = topic;
      if (product && [...productSelect.options].some((o) => o.value === product)) productSelect.value = product;
    });

    const show = (message: string, ok: boolean) => {
      status.textContent = message;
      status.hidden = false;
      status.className = `rounded-xl border px-4 py-3 text-sm sm:col-span-2 ${
        ok ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-rose-200 bg-rose-50 text-rose-800'
      }`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (data.get('_gotcha')) return;

      if (endpoint) {
        button.disabled = true;
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          show("Thank you! Your message has been sent. We'll reply within one business day.", true);
        } catch {
          show(`Sorry, something went wrong. Please email us directly at ${email}.`, false);
        } finally {
          button.disabled = false;
        }
        return;
      }

      const field = (name: string) => String(data.get(name) ?? '').trim() || '-';
      const subject = `${field('topic')}: ${field('name')}`;
      const body = [
        `Name: ${field('name')}`,
        `Email: ${field('email')}`,
        `Company: ${field('company')}`,
        `Phone: ${field('phone')}`,
        `Topic: ${field('topic')}`,
        `Product: ${field('product')}`,
        '',
        field('message'),
      ].join('\n');

      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      show(`Your email app should open with your message ready to send. If it doesn't, write to us at ${email}.`, true);
    });
  }
</script>
