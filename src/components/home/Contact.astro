---
import AppIcon from '../ui/AppIcon.astro';
import { site, hasAddress, fullAddress } from '../../config/site';
import { products } from '../../data/products';

const topics = ['Business enquiry', 'Partnership', 'Product enquiry', 'Product idea', 'Careers', 'Press & media', 'Something else'];
const productOptions = ['General / not sure', ...products.map((p) => p.name)];
const endpoint = site.contactFormEndpoint;
---

<section id="contact" data-theme="paper" class="relative isolate scroll-mt-12 overflow-hidden py-28 sm:py-40">
  <div class="contact-glow pointer-events-none absolute inset-x-0 top-0 -z-10 h-[640px]" aria-hidden="true"></div>

  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <div class="flex justify-center -space-x-3">
        {products.map((p) => <AppIcon product={p} class="size-14 ring-4 ring-[var(--page)]" />)}
      </div>
      <h2 class="mt-8 font-display text-[2.8rem] leading-[1.02] font-semibold tracking-[-0.045em] sm:text-[5rem]">Let’s build what India <span class="text-gradient">needs next.</span></h2>
      <p class="section-lead mx-auto mt-5 max-w-xl">
        A question about an app, a partnership or a role on the team: write to us. We read every message ourselves and reply within one
        business day.
      </p>
    </div>

    <div class="mx-auto mt-14 grid max-w-5xl gap-10 rounded-[28px] bg-white/80 p-6 shadow-[0_30px_80px_-40px_rgba(29,29,31,0.25)] ring-1 ring-black/5 backdrop-blur sm:p-10 lg:grid-cols-[1fr_2fr]" data-reveal>
      <div>
        <h3 class="font-display text-2xl font-semibold tracking-tight text-ink">Say namaste</h3>
        <ul class="mt-5 space-y-4 text-[15px]">
          <li>
            <span class="block text-xs text-muted-foreground">Email</span>
            <a href={`mailto:${site.email}`} class="font-medium text-ink underline decoration-border underline-offset-4 hover:decoration-ink">{site.email}</a>
          </li>
          {
            site.phone && (
              <li>
                <span class="block text-xs text-muted-foreground">Phone</span>
                <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="font-medium text-ink">
                  {site.phone}
                </a>
              </li>
            )
          }
          {
            hasAddress && (
              <li>
                <span class="block text-xs text-muted-foreground">Office</span>
                <span class="text-ink">{fullAddress}</span>
              </li>
            )
          }
          <li>
            <span class="block text-xs text-muted-foreground">Hours</span>
            <span class="text-ink">Mon–Fri · 10:00 AM – 7:00 PM IST</span>
          </li>
        </ul>
      </div>

      <form
          id="contact-form"
          class="grid gap-5 sm:grid-cols-2"
          action={endpoint || `mailto:${site.email}`}
          method="post"
          enctype={endpoint ? undefined : 'text/plain'}
          data-endpoint={endpoint}
          data-email={site.email}
        >
          <div>
            <label for="cf-name" class="label">Full name <span class="text-sindoor">*</span></label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" class="input" placeholder="Aarav Sharma" />
          </div>
          <div>
            <label for="cf-email" class="label">Email <span class="text-sindoor">*</span></label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="160" class="input" placeholder="aarav@company.com" />
          </div>
          <div>
            <label for="cf-company" class="label">Company</label>
            <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="120" class="input" placeholder="Company name" />
          </div>
          <div>
            <label for="cf-phone" class="label">Phone</label>
            <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="20" class="input" placeholder="+91 98765 43210" />
          </div>
          <div>
            <label for="cf-topic" class="label">Topic</label>
            <select id="cf-topic" name="topic" class="input">
              {topics.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div>
            <label for="cf-product" class="label">App</label>
            <select id="cf-product" name="product" class="input">
              {productOptions.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="cf-message" class="label">Message <span class="text-sindoor">*</span></label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              required
              minlength="10"
              maxlength="4000"
              class="input"
              placeholder="Tell us what you have in mind…"></textarea>
          </div>

          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

          <label class="flex items-start gap-3 text-sm text-muted-foreground sm:col-span-2">
            <input type="checkbox" name="consent" required class="mt-0.5 size-4 shrink-0 accent-ink" />
            <span>
              I agree to the <a href="/privacy-policy/" class="font-medium text-ink underline decoration-border underline-offset-4 hover:decoration-ink">Privacy Policy</a>{' '}
              and consent to being contacted about my message.
            </span>
          </label>

          <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
            <button type="submit" class="btn btn-primary btn-lg w-full disabled:cursor-wait disabled:opacity-70 sm:w-auto">Send message</button>
            <p class="text-xs text-muted-foreground">We never share your details with anyone else.</p>
          </div>

          <p id="form-status" role="status" aria-live="polite" hidden class="rounded-2xl px-4 py-3 text-sm sm:col-span-2"></p>
        </form>
    </div>
  </div>
</section>

<style>
  .contact-glow {
    background:
      radial-gradient(28rem 20rem at 32% 38%, rgb(246 194 122 / 0.45), transparent 70%),
      radial-gradient(26rem 20rem at 68% 42%, rgb(243 166 194 / 0.4), transparent 70%),
      radial-gradient(24rem 16rem at 50% 62%, rgb(127 209 196 / 0.28), transparent 70%);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const status = form.querySelector<HTMLElement>('#form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const topicSelect = form.querySelector<HTMLSelectElement>('#cf-topic')!;
    const productSelect = form.querySelector<HTMLSelectElement>('#cf-product')!;
    const endpoint = form.dataset.endpoint;
    const email = form.dataset.email ?? '';

    // Links elsewhere on the page (product cards, "Partner with us", etc.) pre-fill the form.
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element | null)?.closest<HTMLElement>('[data-topic], [data-product]');
      if (!trigger) return;
      const { topic, product } = trigger.dataset;
      if (topic && [...topicSelect.options].some((o) => o.value === topic)) topicSelect.value = topic;
      if (product && [...productSelect.options].some((o) => o.value === product)) productSelect.value = product;
    });

    const show = (message: string, ok: boolean) => {
      status.textContent = message;
      status.hidden = false;
      status.className = `rounded-2xl px-4 py-3 text-sm font-medium sm:col-span-2 ${ok ? 'bg-[#E9F0DD] text-[#2F4F18]' : 'bg-[#F8DFDA] text-[#8E2414]'}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      if (data.get('_gotcha')) return;

      if (endpoint) {
        button.disabled = true;
        try {
          const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          show("Thank you! Your message has been sent. We'll reply within one business day.", true);
        } catch {
          show(`Sorry, something went wrong. Please email us directly at ${email}.`, false);
        } finally {
          button.disabled = false;
        }
        return;
      }

      const field = (name: string) => String(data.get(name) ?? '').trim() || '-';
      const subject = `${field('topic')}: ${field('name')}`;
      const body = [
        `Name: ${field('name')}`,
        `Email: ${field('email')}`,
        `Company: ${field('company')}`,
        `Phone: ${field('phone')}`,
        `Topic: ${field('topic')}`,
        `Product: ${field('product')}`,
        '',
        field('message'),
      ].join('\n');

      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      show(`Your email app should open with your message ready to send. If it doesn't, write to us at ${email}.`, true);
    });
  }
</script>
