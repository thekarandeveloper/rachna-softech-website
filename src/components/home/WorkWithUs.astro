---
import { Check, Handshake, ShieldCheck, Smartphone, Sparkles } from '@lucide/astro';
import SectionHeading from '../SectionHeading.astro';

const paths = [
  {
    icon: Smartphone,
    audience: 'For people',
    name: 'Use our apps',
    summary: 'Simple, private tools for everyday life, designed and supported in India.',
    features: ['Apps for tasks, money, health and more', 'One account across every app', 'Private by design, no ads', 'Real people in support'],
    cta: 'See our products',
    href: '#products',
    topic: undefined,
  },
  {
    icon: Handshake,
    audience: 'For businesses',
    name: 'Partner with us',
    summary: 'Have a project, partnership or distribution idea? We would love to explore it with you.',
    features: ['Partnerships and integrations', 'Co-branded or white-label apps', 'Custom tools built on our platform', 'Distribution and reseller deals'],
    cta: 'Get in touch',
    href: '#contact',
    topic: 'Partnership',
    featured: true,
  },
  {
    icon: Sparkles,
    audience: 'For makers',
    name: 'Join the team',
    summary: 'Designers, engineers and product thinkers who love building things people use every day.',
    features: ['Work on apps used by real people', 'Real ownership from day one', 'Learn across mobile, AI and design', 'A calm, outcome-focused culture'],
    cta: 'Talk to us',
    href: '#contact',
    topic: 'Careers',
  },
];
---

<section id="work-with-us" class="border-b border-slate-200/80 bg-background py-24 sm:py-28">
  <div class="container-x">
    <SectionHeading
      eyebrow="Work with us"
      title='Let&apos;s <span class="text-primary">work together</span>'
      lead="Use our apps, partner with us on a project or join the team. However you want to work together, we would love to hear from you."
    />

    <div class="mt-16 grid items-stretch gap-6 md:grid-cols-3 lg:gap-8">
      {
        paths.map(({ icon: Icon, audience, name, summary, features, cta, href, topic, featured }, i) => (
          <div
            class:list={[
              'relative flex flex-col rounded-2xl bg-white p-7 sm:p-8',
              featured ? 'border-2 border-primary shadow-[0_28px_56px_-28px_rgba(37,99,235,0.45)]' : 'border border-slate-200/80',
            ]}
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            {featured && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-0.5 text-[10px] font-bold tracking-wider whitespace-nowrap text-white uppercase">
                Let's build together
              </span>
            )}
            <span class="flex size-11 items-center justify-center rounded-xl bg-blue-50 text-primary">
              <Icon class="size-5" />
            </span>
            <p class="mt-6 text-xs font-semibold tracking-[0.14em] text-primary uppercase">{audience}</p>
            <h3 class="mt-2 text-2xl font-bold tracking-tight text-foreground">{name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-500">{summary}</p>
            <ul class="mt-6 space-y-3 border-t border-slate-200/70 pt-6 text-sm text-slate-600">
              {features.map((f) => (
                <li class="flex gap-2.5">
                  <Check class="mt-0.5 size-4 shrink-0 text-primary" />
                  {f}
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-8">
              <a href={href} data-topic={topic} class:list={['btn btn-md w-full', featured ? 'btn-primary' : 'btn-outline']}>
                {cta}
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-10 flex items-center justify-center gap-2 text-center text-sm text-slate-500" data-reveal>
      <ShieldCheck class="size-4 shrink-0 text-primary" />
      Every Rachna app is designed, built and supported by our own team in India.
    </p>
  </div>
</section>
