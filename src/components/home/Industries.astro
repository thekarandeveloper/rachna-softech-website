---
import { ArrowRight, BriefcaseBusiness, GraduationCap, HeartPulse, House, Sparkles, Store } from '@lucide/astro';
import { productByKey } from '../../data/products';

const audiences = [
  {
    icon: GraduationCap,
    title: 'Students',
    description: 'Plan assignments, keep an eye on spending and build healthy study habits.',
    products: ['tasks', 'money', 'habits'],
  },
  {
    icon: BriefcaseBusiness,
    title: 'Working professionals',
    description: 'Stay on top of work, bills and health, even on your busiest days.',
    products: ['tasks', 'money', 'health'],
  },
  {
    icon: House,
    title: 'Families',
    description: 'Shared lists, household budgets and health reminders for everyone at home.',
    products: ['tasks', 'money', 'health'],
  },
  {
    icon: Sparkles,
    title: 'Freelancers & creators',
    description: 'Organise projects, track income and expenses, and capture ideas wherever you are.',
    products: ['tasks', 'money', 'notes'],
  },
  {
    icon: HeartPulse,
    title: 'Health-conscious people',
    description: 'Steps, sleep, water and medicines, all in one calm and private place.',
    products: ['health', 'habits'],
  },
].map((a) => ({ ...a, products: a.products.map(productByKey).filter((p) => p !== undefined) }));
---

<section id="industries" class="border-b border-zinc-200/80 bg-white py-24 sm:py-28">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-6 border-b border-zinc-200/80 pb-10 sm:flex-row sm:items-end" data-reveal>
      <div class="max-w-xl space-y-3">
        <p class="text-xs font-semibold tracking-[0.14em] text-primary uppercase">Who we build for</p>
        <h2 class="section-title">Made for the way people in India live</h2>
        <p class="section-lead">
          Students, professionals, families and creators: our apps are designed around real routines, real budgets and real lives.
        </p>
      </div>
      <a href="#contact" data-topic="Partnership" class="btn btn-outline btn-md shrink-0 self-start sm:self-auto">
        Partner with us
        <ArrowRight class="size-4" />
      </a>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        audiences.map(({ icon: Icon, title, description, products }, i) => (
          <article class="card card-hover group flex flex-col p-6" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <span class="flex size-11 items-center justify-center rounded-xl bg-gradient-to-br from-violet-50 to-violet-100/60 text-primary ring-1 ring-violet-100">
              <Icon class="size-5" />
            </span>
            <h3 class="mt-5 text-lg font-semibold tracking-tight text-foreground">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-500">{description}</p>
            <div class="mt-auto pt-5">
              <p class="text-[11px] font-semibold tracking-wider text-zinc-400 uppercase">Apps they'll love</p>
              <ul class="mt-2 flex flex-wrap gap-1.5">
                {products.map((p) => (
                  <li class="inline-flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-2.5 py-0.5 text-xs font-medium text-zinc-700">
                    <span class:list={['size-1.5 rounded-full', p.accent.solid]} />
                    {p.name}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }

      <article class="group flex flex-col rounded-xl border border-violet-200 bg-gradient-to-br from-violet-50 to-white p-6" data-reveal style="--reveal-delay:140ms">
        <span class="flex size-11 items-center justify-center rounded-xl bg-primary text-white shadow-sm">
          <Store class="size-5" />
        </span>
        <h3 class="mt-5 text-lg font-semibold tracking-tight text-foreground">Businesses & brands</h3>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600">
          Want our apps for your employees, customers or community, or a custom tool built on our platform? Let's talk.
        </p>
        <div class="mt-auto pt-5">
          <a href="#contact" data-topic="Business enquiry" class="group/cta inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
            Get in touch
            <ArrowRight class="size-4 transition-transform group-hover/cta:translate-x-0.5" />
          </a>
        </div>
      </article>
    </div>
  </div>
</section>
