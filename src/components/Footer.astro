---
import * as simpleIcons from 'simple-icons';
import Logo from './Logo.astro';
import { site, legalLinks, socialLinks, hasAddress, fullAddress } from '../config/site';
import { products } from '../data/products';

const year = new Date().getFullYear();

const brandIcons = simpleIcons as unknown as Record<string, { path: string } | undefined>;
const LINKEDIN_PATH =
  'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z';
const socialPath: Record<string, string | undefined> = {
  LinkedIn: LINKEDIN_PATH,
  X: brandIcons.siX?.path,
  GitHub: brandIcons.siGithub?.path,
  Instagram: brandIcons.siInstagram?.path,
};

const columns = [
  {
    title: 'Apps',
    links: products.map((p) => ({ label: p.name, href: `/#app-${p.key}` })),
  },
  {
    title: 'Platform',
    links: [
      { label: 'Rachna Account', href: '/#ecosystem' },
      { label: 'Rachna Kit', href: '/#kit' },
      { label: 'Privacy', href: '/#highlights' },
      { label: 'Journey', href: '/#journey' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'Contact', href: '/#contact' },
      { label: 'Careers', href: '/#contact' },
      { label: 'FAQ', href: '/#faq' },
    ],
  },
  { title: 'Legal', links: legalLinks },
];
---

<footer>
  <div class="container-x border-t pt-14 pb-10" style="border-color: var(--line)">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo />
        <p class="mt-4 max-w-xs text-[15px] leading-relaxed text-muted-foreground">Technology, crafted around people. Made in India.</p>
        <a href={`mailto:${site.email}`} class="mt-5 inline-block text-[15px] font-medium text-ink underline decoration-border underline-offset-4 hover:decoration-ink">
          {site.email}
        </a>
        {site.phone && <p class="mt-2 text-[15px] text-muted-foreground">{site.phone}</p>}
        {hasAddress && <p class="mt-2 text-[15px] text-muted-foreground">{fullAddress}</p>}
        {
          socialLinks.length > 0 && (
            <div class="mt-6 flex gap-2">
              {socialLinks.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${site.name} on ${s.label}`}
                  class="flex size-9 items-center justify-center rounded-full bg-surface text-ink/60 transition-colors hover:text-ink"
                >
                  <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                    <path d={socialPath[s.label]} />
                  </svg>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:col-span-8">
        {
          columns.map((col) => (
            <div>
              <h2 class="text-xs font-semibold text-ink">{col.title}</h2>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-xs text-muted-foreground transition-colors hover:text-ink hover:underline">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <p lang="hi" aria-hidden="true" class="mt-16 font-rozha text-[min(34vw,19rem)] leading-[0.85] text-ink/[0.05] select-none">रचना</p>

    <div class="mt-6 flex flex-col gap-4 border-t border-border pt-8 text-xs leading-relaxed text-muted-foreground md:flex-row md:items-end md:justify-between">
      <div class="space-y-1">
        <p>© {year} {site.name}. All rights reserved.</p>
        <p>
          {site.legalName} is a limited liability partnership registered in India with limited liability.
          {site.llpin && <span> LLPIN: {site.llpin}.</span>}
          {site.gstin && <span> GSTIN: {site.gstin}.</span>}
        </p>
        {hasAddress && <p>Registered office: {fullAddress}</p>}
      </div>
      <p class="inline-flex shrink-0 items-center gap-2 font-medium text-ink/70">
        <svg viewBox="0 0 18 12" class="h-3 w-[18px] overflow-hidden rounded-[2px]" aria-hidden="true">
          <rect width="18" height="4" fill="#FF9933"></rect>
          <rect y="4" width="18" height="4" fill="#FFFFFF"></rect>
          <rect y="8" width="18" height="4" fill="#138808"></rect>
          <circle cx="9" cy="6" r="1.5" fill="none" stroke="#000080" stroke-width="0.6"></circle>
        </svg>
        Designed &amp; engineered in India
      </p>
    </div>
  </div>
</footer>
