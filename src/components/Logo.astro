---
interface Props {
  class?: string;
  wordmark?: boolean;
  href?: string;
}

const { class: className, wordmark = true, href = '/' } = Astro.props;
const gradientId = `rs-${Math.random().toString(36).slice(2, 8)}`;
---

<a href={href} class:list={['group inline-flex items-center gap-2.5 rounded-lg', className]} aria-label="Rachna Softech home">
  <svg
    width="32"
    height="32"
    viewBox="0 0 32 32"
    aria-hidden="true"
    class="shrink-0 drop-shadow-[0_2px_6px_rgba(37,99,235,0.28)] transition-transform duration-300 group-hover:-rotate-6"
  >
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
        <stop stop-color="#3B82F6"></stop>
        <stop offset="1" stop-color="#1D4ED8"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill={`url(#${gradientId})`}></rect>
    <path
      d="M11 23.5V8.5h6a4.5 4.5 0 0 1 0 9h-6m5.2 0 5.3 6"
      fill="none"
      stroke="#fff"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <circle cx="23.5" cy="8.5" r="2" fill="#BFDBFE"></circle>
  </svg>
  {
    wordmark && (
      <span class="text-[17px] font-semibold tracking-tight text-foreground">
        Rachna <span class="font-medium text-slate-400">Softech</span>
      </span>
    )
  }
</a>
