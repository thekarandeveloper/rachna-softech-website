---
/** The Rachna Labs wordmark: रचना in Rozha One, with "labs" set quietly beside it. */
interface Props {
  class?: string;
  href?: string;
}

const { class: className, href = '/' } = Astro.props;
---

<a href={href} class:list={['inline-flex items-baseline gap-1.5 rounded-lg', className]} aria-label="Rachna Labs home">
  <span lang="hi" class="font-rozha text-[28px] leading-none">रचना</span>
  <span class="font-display text-[17px] leading-none font-medium tracking-tight opacity-55">labs</span>
</a>
