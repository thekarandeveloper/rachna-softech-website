---
/** A simple iPhone-style frame for screens built in HTML. */
interface Props {
  class?: string;
  dark?: boolean;
}

const { class: className, dark = false } = Astro.props;
---

<div class:list={['phone relative rounded-[3rem] bg-[#111] p-[10px] shadow-[0_40px_80px_-30px_rgba(0,0,0,0.5)]', className]}>
  <div class:list={['relative aspect-[9/19.5] overflow-hidden rounded-[2.4rem]', dark ? 'bg-[#0b1415] text-white' : 'bg-white text-[#1d1d1f]']}>
    <div class="flex h-11 items-center justify-between px-7 pt-1 text-[12px] font-semibold">
      <span>9:41</span>
      <span class="absolute top-2.5 left-1/2 h-[26px] w-[90px] -translate-x-1/2 rounded-full bg-black"></span>
      <span class="flex items-center gap-1">
        <span class="h-2.5 w-4 rounded-[3px] border border-current opacity-80"></span>
      </span>
    </div>
    <slot />
  </div>
</div>
