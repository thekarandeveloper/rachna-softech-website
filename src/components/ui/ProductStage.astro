---
/**
 * A full-screen chapter for one app, painted in that app's theme. The page eases into the
 * theme as the chapter reaches the middle of the screen. The visual goes in the default slot.
 */
import { ArrowRight, Check } from '@lucide/astro';
import * as simpleIcons from 'simple-icons';
import AppIcon from './AppIcon.astro';
import { productCta, statusLabel, type Product } from '../../data/products';

interface Props {
  product: Product;
  reverse?: boolean;
}

const { product, reverse = false } = Astro.props;
const cta = productCta(product);
const apple = (simpleIcons as unknown as Record<string, { path: string }>).siApple.path;
---

<section id={`app-${product.key}`} data-theme={product.key} class="scroll-mt-12 overflow-hidden py-24 sm:py-32">
  <div class="container-x grid min-h-[80svh] items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div class:list={['max-w-xl', reverse && 'lg:order-2']} data-reveal>
      <div class="flex items-center gap-3">
        <AppIcon product={product} class="size-14" />
        <div>
          <p class="text-[15px] font-semibold">{product.category}</p>
          <p class="text-muted text-[13px]">{statusLabel[product.status]} · {product.platforms}</p>
        </div>
      </div>

      <h2 class="mt-8 font-display text-[3.6rem] leading-[0.95] font-semibold tracking-[-0.05em] sm:text-[5.5rem]">{product.name}</h2>
      <p class="mt-4 font-display text-[1.6rem] leading-[1.15] font-semibold tracking-[-0.03em] sm:text-[2rem]" style="color: var(--accent)">
        {product.tagline}.
      </p>
      <p class="text-muted mt-5 text-lg leading-relaxed">{product.description}</p>

      <ul class="mt-7 space-y-3">
        {
          product.features.map((f) => (
            <li class="flex items-center gap-3 text-[17px]">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full" style="background: var(--accent); color: var(--accent-ink)">
                <Check class="size-3.5" stroke-width={3} />
              </span>
              {f}
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href={cta.href}
          {...(cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : { 'data-topic': 'Product enquiry', 'data-product': product.name })}
          class="btn btn-lg btn-accent"
        >
          {cta.external && (
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <path d={apple} />
            </svg>
          )}
          {cta.external ? cta.label : 'Get notified'}
          {!cta.external && <ArrowRight class="size-4" />}
        </a>
        <a href="/#contact" data-topic="Partnership" data-product={product.name} class="btn btn-lg btn-glass">Partner with us</a>
      </div>
    </div>

    <div class:list={['relative', reverse && 'lg:order-1']} data-reveal style="--reveal-delay: 120ms">
      <slot />
    </div>
  </div>
</section>
