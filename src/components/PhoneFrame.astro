---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['rounded-[2.4rem] border border-zinc-200 bg-white p-2 shadow-2xl shadow-zinc-900/15', className]}>
  <div class="relative flex aspect-[9/19] flex-col overflow-hidden rounded-[2rem] bg-zinc-50 text-left">
    <div class="flex items-center justify-between px-5 pt-2.5 pb-1 text-[10px] font-semibold text-zinc-800">
      <span>9:41</span>
      <span class="absolute top-2 left-1/2 h-[18px] w-16 -translate-x-1/2 rounded-full bg-zinc-900"></span>
      <span class="flex items-center gap-1.5">
        <span class="flex items-end gap-px">
          <span class="h-1.5 w-[3px] rounded-sm bg-zinc-800"></span>
          <span class="h-2 w-[3px] rounded-sm bg-zinc-800"></span>
          <span class="h-2.5 w-[3px] rounded-sm bg-zinc-800"></span>
        </span>
        <span class="h-2.5 w-5 rounded-[3px] border border-zinc-800 p-px"><span class="block h-full w-3/4 rounded-[1px] bg-zinc-800"></span></span>
      </span>
    </div>
    <slot />
  </div>
</div>
