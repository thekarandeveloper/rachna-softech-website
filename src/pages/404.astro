---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist or has moved." noindex>
  <section class="relative overflow-hidden bg-white">
    <div class="container-x relative flex min-h-[72vh] flex-col items-center justify-center py-24 text-center">
      <span class="rounded-full border border-violet-200 bg-violet-50 px-3 py-1 font-mono text-xs font-medium text-violet-700">Error 404</span>
      <h1 class="mt-6 text-4xl font-bold tracking-tight text-foreground sm:text-6xl" style="letter-spacing: -0.035em">
        This page doesn't exist
      </h1>
      <p class="mt-5 max-w-md text-base leading-relaxed text-zinc-600">
        The link may be broken or the page may have moved. Let's get you back on track.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary btn-lg">Back to home <ArrowRight class="size-4" /></a>
        <a href="/#contact" class="btn btn-outline btn-lg">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
